# Base de datos Postgres gratuita (Neon desde Vercel → Storage, o Supabase). Sin ella, en local se usa PGlite.
DATABASE_URL=

# Proveedor de IA gratuito. Con GEMINI_API_KEY se usa Gemini; con GROQ_API_KEY, Groq. Sin ninguna, modo simulado.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Forzar un proveedor: groq | gemini | mock
LLM_PROVIDER=

# Usuario de prueba (si se dejan vacíos, la app no pide login)
DEMO_USER=
DEMO_PASSWORD=
AUTH_SECRET=
