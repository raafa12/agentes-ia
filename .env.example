# Base de datos Postgres gratuita (Neon desde Vercel → Storage, o Supabase). Sin ella, en local se usa PGlite.
DATABASE_URL=

# Proveedor de IA gratuito. Se usa el primero que tenga clave: Gemini, Groq u OpenRouter. Sin ninguna, modo simulado.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
# Enrutador de modelos gratuitos de OpenRouter; o un modelo concreto acabado en ":free"
OPENROUTER_MODEL=openrouter/free
# Forzar un proveedor: gemini | groq | openrouter | mock
LLM_PROVIDER=

# Usuario de prueba (si se dejan vacíos, la app no pide login)
DEMO_USER=
DEMO_PASSWORD=
AUTH_SECRET=
